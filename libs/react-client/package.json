{
  "name": "@chainlit/react-client",
  "description": "Websocket client to connect to your chainlit/chainnext app.",
  "version": "0.5.0",
  "scripts": {
    "dev": "tsup src/index.ts --clean --format esm,cjs --dts  --external react --external recoil --minify --sourcemap --treeshake",
    "build": "tsup src/index.ts --tsconfig tsconfig.build.json --clean --format esm,cjs --dts  --external react --external recoil --minify --sourcemap --treeshake",
    "type-check": "tsc --noemit",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Puyanfar/chainnext.git",
    "directory": "libs/react-client"
  },
  "private": false,
  "keywords": [
    "llm",
    "ai",
    "chain of thought"
  ],
  "author": "Chainlit",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "devDependencies": {
    "@swc/core": "^1.16.22",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^14.3.1",
    "@types/lodash": "^4.17.27",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "jsdom": "^22.1.0",
    "tslib": "^2.9.1",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^4.1.12"
  },
  "peerDependencies": {
    "@types/react": "^18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recoil": "^0.7.7"
  },
  "dependencies": {
    "jwt-decode": "^3.1.2",
    "lodash": "^4.18.1",
    "socket.io-client": "^4.8.4",
    "sonner": "^1.7.4",
    "swr": "^2.5.1",
    "uuid": "^11.1.1"
  }
}
