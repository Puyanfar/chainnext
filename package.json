{
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "cypress": "^16.3.0",
    "cypress-plugin-steps": "1.2.2",
    "cypress-split": "^1.25.0",
    "dotenv": "^16.6.1",
    "eslint": "^10.14.0",
    "eslint-plugin-chai-friendly": "^1.2.1",
    "eslint-plugin-cypress": "^6.4.4",
    "fkill": "^9.0.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.10.1",
    "shell-exec": "^1.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "build": "pnpm run --recursive build",
    "lint": "eslint",
    "lint:fix": "pnpm lint --fix",
    "format-check:files": "prettier --check --ignore-unknown",
    "format-check": "pnpm format-check:files .",
    "format:files": "pnpm format-check:files --write",
    "format": "pnpm format-check --write",
    "type-check": "pnpm run --parallel type-check",
    "check-overrides": "node scripts/check-pnpm-overrides.mjs",
    "test": "pnpm run --recursive test",
    "test:e2e": "cypress run",
    "test:e2e:interactive": "cypress open"
  },
  "packageManager": "pnpm@12.22.0",
  "engines": {
    "node": ">=26.13.1",
    "npm": ">=12.2.3",
    "pnpm": ">=12.22.0"
  }
}
